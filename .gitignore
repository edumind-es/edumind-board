# Dependencies
node_modules/
vendor/
# ...pero `apps/web/public/vendor/` NO es una dependencia: es el sistema de
# diseno Lamina vendorizado, y el index.html lo carga con
# <link href="/vendor/lamina-v1.css">. La regla de arriba (pensada para
# Composer) lo dejaba fuera de la release publica, asi que quien clonaba se
# quedaba sin los estilos y sin ningun error que lo explicara.
!apps/web/public/vendor/
venv/
.venv/
__pycache__/
*.py[cod]

# Builds and generated output
dist/
build/
.next/
out/
coverage/
htmlcov/
playwright-report/
test-results/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.local

# Runtime data, user content and backups
/data/
/apps/api/data/
uploads/
static/uploads/
backend/static/uploads/
backups/
backup/
*.sqlite
*.sqlite-*
*.db
*.sql
*.sql.gz
*.log

# Local/editor state
.DS_Store
.idea/
.vscode/
.local/
.build/
run/

# Deployment-local files
*.service
*.conf
*.bak
*.new
