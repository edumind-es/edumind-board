# Web
VITE_API_BASE_URL=http://localhost:3100

# API
PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/edumind-board.sqlite
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:3100
WEB_BASE_URL=http://localhost:5173
AUTHENTIK_ENABLED=false
AUTHENTIK_ISSUER_URL=https://auth.edumind.es/application/o/edumind-board/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES=openid profile email
SESSION_COOKIE_NAME=edumind_board_session
SESSION_SECRET=change-me
CLASSROOM_EVENT_RETENTION_HOURS=24
ARASAAC_CACHE_TTL_HOURS=168

# Recursos educativos servidos desde disco.
# OJO: el valor por defecto de EDUMIND_RESOURCES_ROOT es una ruta del
# servidor de EDUmind. En cualquier otra instalación hay que ponerlo, o la
# sección de recursos quedará vacía sin explicar por qué.
EDUMIND_RESOURCES_ROOT=/ruta/a/tus/recursos/published
EDUMIND_RESOURCES_CATALOG_URL=https://edumind.es/es/explore/resources
# Quién puede embeber los recursos en un iframe (directiva frame-ancestors).
EDUMIND_RESOURCES_FRAME_ANCESTORS='self'

# Sólo para desarrollo (los fija scripts/dev.mjs; ver CLAUDE.md).
# EDUMIND_DEV_API_PORT=3110
# EDUMIND_DEV_WEB_PORT=5180
# VITE_DEV_API_TARGET=http://127.0.0.1:3110

# Música de aula (CC BY 4.0, Kevin MacLeod). Se genera con:
#   node scripts/curar-musica.mjs
# Los ficheros NO están en git: pesan ~176 MB y se descargan del origen.
EDUMIND_MUSICA_ROOT=./data/musica
# El catálogo vive junto a los mp3; sólo hace falta si los separas.
# EDUMIND_MUSICA_CATALOGO=./data/musica/catalogo.json
